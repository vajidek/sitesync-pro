# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database Connection String
DATABASE_URL="postgresql://sitesync:sitesync_secret@localhost:5432/sitesyncpro?schema=public"

# JWT Authentication Secrets
JWT_SECRET="sitesync-pro-enterprise-jwt-access-secret-2026-key"
JWT_REFRESH_SECRET="sitesync-pro-enterprise-jwt-refresh-secret-2026-key"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Progressive Web App (PWA) Environment Configuration
# VITE_PWA_ENABLE="true" to register Service Worker, "false" or missing to disable
VITE_PWA_ENABLE=false

