# SiteSync Pro environment template
# Never commit real credentials or secrets. Configure them through your deployment secret store.

# Gemini AI
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"

# PostgreSQL
DATABASE_URL="postgresql://sitesync:CHANGE_ME@localhost:5432/sitesyncpro?schema=public"
SQL_HOST="localhost"
SQL_USER="sitesync"
SQL_PASSWORD="CHANGE_ME"
SQL_DB_NAME="sitesyncpro"

# Browser CORS allowlist (comma-separated). Leave empty for same-origin only in UAT/PRODUCTION.
APP_ALLOWED_ORIGINS=""

# Application environment
# DEMO = synthetic/demo seed data permitted
# UAT / PRODUCTION = real data only; demo seeding is disabled
APP_ENVIRONMENT="DEMO"
ENABLE_DEMO_SEED="true"

# JWT authentication
# Use long, cryptographically random values in UAT/PRODUCTION.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Progressive Web App
VITE_PWA_ENABLE=false
