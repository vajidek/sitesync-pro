datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum SystemRole {
  ADMIN
  MANAGER
  INCHARGE
  SUPERVISOR
  STORE_KEEPER
  DRIVER
  OPERATOR
  WORKER
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  SUSPENDED
  TERMINATED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  SUSPENDED
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  UNDER_REPAIR
  DECOMMISSIONED
}

enum VehicleStatus {
  ACTIVE
  IN_SERVICE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
}

enum StockTransactionType {
  INWARD_PURCHASE
  OUTWARD_DISPATCH
  INTER_WAREHOUSE_TRANSFER
  SITE_ISSUE
  SITE_RETURN
  DAMAGE_ADJUSTMENT
}

enum EntityType {
  EMPLOYEE
  PROJECT
  SITE
  VEHICLE
  EQUIPMENT
  MATERIAL
  CONTRACTOR
  VENDOR
  CUSTOMER
  STOCK_TRANSACTION
}

// ==========================================
// MASTER & ORGANIZATIONAL MODELS
// ==========================================

model Company {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  taxId       String?
  email       String?
  phone       String?
  website     String?
  address     String?
  logoUrl     String?
  currency    String   @default("AED")
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  projects    Project[]

  @@index([code])
}

model Branch {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments Department[]

  @@index([companyId])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  description String?
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  designations Designation[]
  employees    Employee[]
}

model Designation {
  id           String      @id @default(uuid())
  code         String      @unique
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  gradeLevel   String?
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employees    Employee[]
}

// ==========================================
// USER & IDENTITY MODELS
// ==========================================

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  name                String
  phone               String?
  department          String?
  avatarUrl           String?
  roleId              String
  role                Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employeeId          String?        @unique
  employee            Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedProjectId   String?
  assignedProjectName String?
  isActive            Boolean        @default(true)
  isEmailVerified     Boolean        @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  projectMemberships  ProjectMember[]
  managedProjects     Project[]      @relation("ProjectManager")
  operatedEquipment   Equipment[]    @relation("EquipmentOperator")
  uploadedDocuments   Document[]     @relation("DocumentUploader")
  notifications       Notification[]

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String
  isActive    Boolean          @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  module      String
  description String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

// ==========================================
// HUMAN RESOURCES & EMPLOYEES
// ==========================================

model Employee {
  id                 String         @id @default(uuid())
  employeeCode       String         @unique
  name               String
  photoUrl           String?
  phone              String
  email              String         @unique
  address            String?
  emergencyContact   String?
  dateOfJoining      DateTime
  departmentId       String?
  department         Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId      String?
  designation        Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManagerId String?
  reportingManager   Employee?      @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates       Employee[]     @relation("ManagerSubordinates")
  status             EmployeeStatus @default(ACTIVE)
  baseSalary         Float          @default(0.0)
  hourlyRate         Float          @default(0.0)
  passportNumber     String?
  nationalId         String?
  isActive           Boolean        @default(true)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User?
  assignedVehicles   Vehicle[]      @relation("AssignedDriver")

  @@index([employeeCode])
  @@index([departmentId])
  @@index([designationId])
}

// ==========================================
// PROJECTS, SITES & CONTRACTORS
// ==========================================

model Project {
  id               String        @id @default(uuid())
  projectCode      String        @unique
  projectName      String
  companyId        String?
  company          Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  location         String
  latitude         Float?
  longitude        Float?
  startDate        DateTime
  endDate          DateTime
  status           ProjectStatus @default(PLANNING)
  budget           Float         @default(0.0)
  projectManagerId String?
  projectManager   User?         @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  description      String?
  isActive         Boolean       @default(true)
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sites            Site[]
  members          ProjectMember[]
  equipment        Equipment[]
  stockTransactions StockTransaction[]

  @@index([projectCode])
  @@index([status])
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInProject String @default("Member")
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Site {
  id         String     @id @default(uuid())
  siteCode   String     @unique
  siteName   String
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location   String
  latitude   Float?
  longitude  Float?
  inchargeId String?
  status     SiteStatus @default(ACTIVE)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  warehouses Warehouse[]
  equipment  Equipment[]

  @@index([projectId])
  @@index([siteCode])
}

model Contractor {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxId         String?
  tradeLicense  String?
  category      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Vendor {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxId         String?
  rating        Float    @default(5.0)
  paymentTerms  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxId         String?
  creditLimit   Float     @default(0.0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
}

model WorkCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// PLANT, MACHINERY & VEHICLES
// ==========================================

model Equipment {
  id               String          @id @default(uuid())
  code             String          @unique
  name             String
  type             String
  serialNumber     String?         @unique
  modelNumber      String?
  status           EquipmentStatus @default(AVAILABLE)
  hourlyCost       Float           @default(0.0)
  currentProjectId String?
  currentProject   Project?        @relation(fields: [currentProjectId], references: [id], onDelete: SetNull)
  siteId           String?
  site             Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  operatorId       String?
  operator         User?           @relation("EquipmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  isActive         Boolean         @default(true)
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([code])
  @@index([status])
}

model Vehicle {
  id              String        @id @default(uuid())
  vehicleNumber   String        @unique
  vehicleType     String
  fuelType        FuelType      @default(DIESEL)
  currentOdometer Float         @default(0.0)
  insurancePolicy String?
  insuranceExpiry DateTime?
  rcNumber        String?
  fitnessExpiry   DateTime?
  assignedDriverId String?
  assignedDriver  Employee?     @relation("AssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  status          VehicleStatus @default(ACTIVE)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([vehicleNumber])
}

// ==========================================
// INVENTORY, MATERIALS & WAREHOUSES
// ==========================================

model MaterialCategory {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  materials   Material[]
}

model MaterialUnit {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  materials   Material[]
}

model Material {
  id            String           @id @default(uuid())
  itemCode      String           @unique
  name          String
  categoryId    String
  category      MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  specification String?
  unitId        String
  unit          MaterialUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  minStock      Float            @default(0.0)
  maxStock      Float            @default(1000.0)
  currentStock  Float            @default(0.0)
  unitPrice     Float            @default(0.0)
  barcode       String?          @unique
  qrCode        String?          @unique
  isActive      Boolean          @default(true)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  stocks        Stock[]
  transactions  StockTransaction[]

  @@index([itemCode])
  @@index([categoryId])
}

model Warehouse {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  location    String
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  managerId   String?
  capacity    Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks       Stock[]
  transactions StockTransaction[]

  @@index([code])
}

model Stock {
  id               String    @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  materialId       String
  material         Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity         Float     @default(0.0)
  reservedQuantity Float     @default(0.0)
  batchNumber      String?
  rackLocation     String?
  updatedAt        DateTime  @updatedAt

  @@unique([warehouseId, materialId])
  @@index([warehouseId])
  @@index([materialId])
}

model StockTransaction {
  id                String               @id @default(uuid())
  transactionNumber String               @unique
  type              StockTransactionType
  materialId        String
  material          Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  warehouseId       String
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  projectId         String?
  project           Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quantity          Float
  unitPrice         Float                @default(0.0)
  referenceNo       String?
  performedBy       String?
  notes             String?
  createdAt         DateTime             @default(now())

  @@index([transactionNumber])
  @@index([materialId])
  @@index([warehouseId])
}

// ==========================================
// DOCUMENTS, ATTACHMENTS & NOTIFICATIONS
// ==========================================

model Document {
  id           String     @id @default(uuid())
  title        String
  fileUrl      String
  fileType     String
  fileSize     Int        @default(0)
  entityType   EntityType
  entityId     String
  uploadedById String?
  uploadedBy   User?      @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  group       String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  module     String
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}
